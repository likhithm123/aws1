# ============================================================
# Murgdur E-Commerce Platform — Environment Variables Template
# Copy this file to .env at project root (for Docker Compose)
# or into backend/.env and frontend/.env.local (for local dev)
# ============================================================

# ── Database & Cache ──────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/murgdurV2?schema=public"
REDIS_URL="redis://localhost:6379"

# ── Authentication ───────────────────────────────────────────
JWT_SECRET="change-me-min-32-chars-long-secret"
JWT_REFRESH_SECRET="change-me-different-refresh-secret"
NEXTAUTH_SECRET="change-me-min-32-chars-long-secret"
NEXTAUTH_URL="http://localhost:3000"

# ── AWS S3 & CloudFront (Media & Invoices Storage) ───────────
AWS_REGION="us-east-1"
AWS_S3_BUCKET="murgdur-media"
AWS_CLOUDFRONT_DOMAIN="https://media.murgdur.com"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ── Amazon OpenSearch / Elasticsearch ─────────────────────────
AWS_OPENSEARCH_ENDPOINT=""
AWS_OPENSEARCH_USERNAME=""
AWS_OPENSEARCH_PASSWORD=""

# ── App Endpoints & CDN ───────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"
INTERNAL_API_URL="http://localhost:3001"
NEXT_PUBLIC_CDN_URL="https://media.murgdur.com"
NEXT_PUBLIC_SITE_URL="https://murgdur.com"

# ── Email Service (SMTP) ──────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# ── Payments (WhatsApp Concierge / COD) ───────────────────────
# Orders placed via luxury WhatsApp concierge or Pay on Delivery

# ── Monitoring & Admin ────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
ADMIN_EMAIL="admin@murgdur.com"
ADMIN_PASSWORD="Admin@123"